PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hireon?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Client origins (comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Razorpay (TEST MODE keys for now — swap to live keys before prod)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Platform commission taken on every delivery fare (%). Used for both the
# ONLINE-payment rider payout split and the COD wallet commission debit.
COMMISSION_PERCENT=20

# Wallet floor in paise (negative = rider allowed to go this much into due
# before COD orders are blocked). Default below = -₹500.
WALLET_MIN_BALANCE_PAISE=-50000

# Refer & Earn — rider ka dost (rider ya customer) invite code/link se signup kare
# to rider ke wallet me bonus. Amount paise me (10000 = ₹100).
REFERRAL_ENABLED=true
REFERRAL_REWARD_PAISE=10000
# Ek rider ko pichhle 30 din me max kitne referral rewards (0 = koi limit nahi)
REFERRAL_MONTHLY_LIMIT=25
# Invite link ka base (default: Play Store listing com.hireon)
# REFERRAL_STORE_URL=https://play.google.com/store/apps/details?id=com.hireon
